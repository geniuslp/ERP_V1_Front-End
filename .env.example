# API Configuration
# NOTE: VITE_API_URL already includes the /api/v1 suffix.
VITE_API_URL=http://localhost:8080/api/v1

# Deployment target (build-time). Defaults reproduce the current prod build.
# Base path the site is served under (leading/trailing slash added automatically).
#   prod: /erp/        UAT: /erp/uat/
VITE_BASE_PATH=/erp/
# Prefix for every localStorage/sessionStorage key. Empty = existing prod keys.
#   prod: (empty)      UAT: uat_
VITE_STORAGE_PREFIX=
# 'prod' (default) or 'uat' — 'uat' shows a small UAT tag in the header.
VITE_APP_ENV=prod

# App Configuration
VITE_APP_NAME=ERP System
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false
